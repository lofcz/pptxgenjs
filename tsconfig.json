{
	"compilerOptions": {
		"allowSyntheticDefaultImports": true,
		"declaration": true,
		"declarationDir": "./out/defs",

		"lib": [
			"dom",
			"es2022"
		],
		"module": "es2020",
		"moduleResolution": "bundler",
		"noImplicitAny": false,
		"outDir": "./out",
		"rootDir": "./src", // ponytail: TS6 no longer infers this
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"strictNullChecks": true,
		"target": "es2016",
		"types": ["node"]
	},
	"display": "Recommended",
	"$schema": "https://json.schemastore.org/tsconfig",
	"include": [
		"src/**/*"
	],
	"exclude": [
		"src/vendor/fonteditor-core/**/*.js"
	]
}

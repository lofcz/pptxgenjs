{
	"compilerOptions": {
		"allowSyntheticDefaultImports": true,
		"declaration": true,
		"declarationDir": "./out/defs",
		"ignoreDeprecations": "6.0", // ponytail: node10 resolution removed in TS7; revisit (switch to "bundler") when upgrading to TS7

		"lib": [
			"dom",
			"es2020"
		],
		"module": "es2020",
		"moduleResolution": "node",
		"noImplicitAny": false,
		"outDir": "./out",
		"rootDir": "./src", // ponytail: TS6 no longer infers this
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"strictNullChecks": true,
		"target": "es2016",
		"types": ["node"]
	},
	"display": "Recommended",
	"$schema": "https://json.schemastore.org/tsconfig",
	"include": [
		"src/**/*"
	],
	"exclude": [
		"src/bld/**",
		"src/vendor/fonteditor-core/**/*.js"
	]
}
